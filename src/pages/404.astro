---
import SiteLayout from '../layouts/SiteLayout.astro';
import Mark from '../components/Mark.astro';
---
<SiteLayout title="Not found" description="This page isn't here.">
  <section class="lost wrap">
    <p class="label">Error — 404</p>
    <h1 class="lost__title">Nothing <i>here.</i> Which is, in its way, quite mundane.</h1>
    <p>The page may have moved, or never existed. Try <a href="/home/">home</a>, or look through <a href="/everything/">everything</a>.</p>
    <Mark name="scribble" class="lost__mark" />
  </section>
</SiteLayout>
